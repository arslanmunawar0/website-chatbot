# Crawler
CRAWLER_HEADLESS=true
CRAWLER_CSS_SELECTOR=main
CRAWLER_MIN_CONTENT_LENGTH=100
CRAWLER_URL_CONTAINS=
CRAWLER_DEEP_CRAWL=false
CRAWLER_MAX_DEPTH=2
CRAWLER_VERBOSE=false

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# Main script (python main.py)
WEBSITES_FILE=websites.json
SAVE_TO_QDRANT=true
# OUTPUT_JSON=data/chunks.json

# Qdrant — put real values in .env (not here)
QDRANT_URL=https://YOUR-CLUSTER-ID.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_PREFIX=
QDRANT_VECTOR_SIZE=1024
QDRANT_RECREATE_COLLECTION=false

# Chat API (chatbot-api)
# Any LangChain chat model as "provider:model", e.g. openai:gpt-4o-mini or anthropic:claude-3-5-haiku-latest
LLM_MODEL=openai:gpt-4o-mini
LLM_TEMPERATURE=0
OPENAI_API_KEY=your-openai-api-key
RETRIEVAL_TOP_K=5
CORS_ORIGINS=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000
